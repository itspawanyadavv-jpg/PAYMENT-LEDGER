# ==============================================================================
# Payment Ledger Microservice - Environment Configuration
# ==============================================================================

# Server Configuration
SERVER_PORT=8080

# PostgreSQL Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=payment_ledger
POSTGRES_USER=payment_user
POSTGRES_PASSWORD=payment_pass
SPRING_DATASOURCE_URL=jdbc:postgresql://${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# Redis Configuration (Idempotency L1 Distributed Lock)
REDIS_HOST=localhost
REDIS_PORT=6379
SPRING_DATA_REDIS_HOST=${REDIS_HOST}
SPRING_DATA_REDIS_PORT=${REDIS_PORT}

# Apache Kafka Configuration (Transactional Outbox Event Broker)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
SPRING_KAFKA_BOOTSTRAP_SERVERS=${KAFKA_BOOTSTRAP_SERVERS}
KAFKA_TOPIC_PAYMENT_EVENTS=payment.events

# Ledger & Idempotency Business Logic Configuration
PAYMENT_OUTBOX_POLL_INTERVAL_MS=500
PAYMENT_OUTBOX_BATCH_SIZE=100
PAYMENT_IDEMPOTENCY_TTL_HOURS=24
